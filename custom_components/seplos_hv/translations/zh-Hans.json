{
  "config": {
    "step": {
      "user": {
        "title": "Seplos HV BMS",
        "description": "选择 Home Assistant 连接 BCU-1002C 主控盒的方式。",
        "menu_options": {
          "tcp": "网络（TCP 网关）",
          "serial": "串口（USB RS485 适配器）"
        }
      },
      "tcp": {
        "title": "网络连接",
        "description": "连接到设置为透传模式的 Waveshare RS232/485/422 TO POE ETH (B) 网关（或同类产品）。",
        "data": {
          "host": "主机",
          "port": "端口"
        },
        "data_description": {
          "host": "TCP 网关的 IP 地址或主机名。",
          "port": "网关监听的 TCP 端口（默认 8899）。"
        }
      },
      "serial": {
        "title": "串口连接",
        "description": "连接到接入 BCU RS485-1 端口的本地 USB RS485 适配器。",
        "data": {
          "serial_port": "串口设备",
          "baudrate": "波特率"
        },
        "data_description": {
          "serial_port": "设备路径，例如 /dev/ttyUSB0。",
          "baudrate": "必须与 BCU 配置的波特率一致（默认 57600）。"
        }
      }
    },
    "error": {
      "cannot_connect": "无法连接到 BCU。",
      "timeout": "BCU 未在规定时间内响应。",
      "unknown": "发生意外错误。"
    },
    "abort": {
      "already_configured": "该 BMS 已配置。"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Seplos HV BMS 选项",
        "data": {
          "fast_interval": "快速轮询间隔（秒）",
          "medium_interval": "中速轮询间隔（秒）",
          "slow_interval": "慢速轮询间隔（秒）",
          "enable_cell_sensors": "启用单体电压传感器"
        },
        "data_description": {
          "fast_interval": "读取电池组概要与状态的频率（默认 15 秒）。",
          "medium_interval": "读取电芯电压与温度的频率（默认 60 秒）。",
          "slow_interval": "读取保护参数的频率（默认 3600 秒）。",
          "enable_cell_sensors": "为每个电芯创建一个传感器（最多 128 个）。无论是否开启该选项，这些传感器都会存在，关闭时默认处于禁用状态。"
        }
